# Copia este archivo como `server/.env` (lo lee el backend en modo local).
#   cp server/.env.example server/.env        (Linux/macOS)
#   copy server\.env.example server\.env      (Windows)
# Los `.env` reales están en .gitignore y NO se suben al repositorio.

# Puerto del servidor backend (por defecto 4000)
PORT=4000

# Secreto para firmar los tokens JWT (usa uno propio en producción)
JWT_SECRET=TuPalabraSecretaSuperSeguraParaLosTokensDeApuestas123!

# development | production
NODE_ENV=development

# true = simula la caída de la pasarela SnailPay (Error 2.3.3) en todo depósito
# false = pasarela operando con normalidad (valor por defecto)
FORCE_ERROR=false

# Intervalo entre carreras en milisegundos (por defecto 15000 = 15 s)
RACE_INTERVAL_MS=15000

# Duración de cada carrera en milisegundos (por defecto 5000 = 5 s)
DURATION_OF_RACE_MS=5000
