# Copia este archivo como `.env` en la RAÍZ del proyecto (lo lee docker compose).
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)
# Los `.env` reales están en .gitignore y NO se suben al repositorio.

# true = simula la caída de la pasarela SnailPay (Error 2.3.3) en todo depósito
# false = pasarela operando con normalidad (valor por defecto)
FORCE_ERROR=false

# Intervalo entre carreras en milisegundos (por defecto 15000 = 15 s)
RACE_INTERVAL_MS=15000

# Duración de cada carrera en milisegundos (por defecto 5000 = 5 s)
DURATION_OF_RACE_MS=5000
